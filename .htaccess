# SPA routing for the AI Framework React app on Apache/cPanel.
# Real files and folders (like /playbooks/) are served as-is;
# everything else falls through to index.html for client-side routing.
Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
